# ============================================================
# Café Task Management — Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# Never commit .env.local to version control.

# ── Business name (shown in the nav and browser tab) ─────────
NEXT_PUBLIC_BUSINESS_NAME=Your Café Name

# ── Supabase (public — safe for browser) ──────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Supabase Service Role (SERVER ONLY — never expose to browser) ──
# Found in: Supabase Dashboard → Project Settings → API → service_role key
# Used by: /api/admin/users route (admin user creation)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Resend (email notifications) ──────────────────────────────
# Sign up at resend.com, create an API key
RESEND_API_KEY=re_your_resend_api_key

# Email address used as the "from" sender (must be a verified domain in Resend)
EMAIL_FROM=tasks@yourdomain.com

# Admin email address to receive missed-task notifications
ADMIN_EMAIL=owner@yourdomain.com

# ── Edge Function secret ───────────────────────────────────────
# A random secret string shared between GitHub Actions and your Edge Functions.
# Generate with: openssl rand -hex 32
# Set this BOTH here (for local testing via curl) AND in GitHub Actions secrets.
FUNCTION_SECRET=your-random-secret-here

# ============================================================
# WHERE EACH SECRET LIVES
# ============================================================
#
# Vercel (Production / Preview):
#   NEXT_PUBLIC_SUPABASE_URL        ← add to Vercel project env vars
#   NEXT_PUBLIC_SUPABASE_ANON_KEY   ← add to Vercel project env vars
#   SUPABASE_SERVICE_ROLE_KEY       ← add to Vercel project env vars (server-only)
#   RESEND_API_KEY                  ← add to Vercel project env vars (server-only)
#   EMAIL_FROM                      ← add to Vercel project env vars
#   ADMIN_EMAIL                     ← add to Vercel project env vars
#
# Supabase Edge Functions (set via Supabase CLI or Dashboard):
#   SUPABASE_URL                    ← automatically injected by Supabase runtime
#   SUPABASE_SERVICE_ROLE_KEY       ← set as Edge Function secret
#   RESEND_API_KEY                  ← set as Edge Function secret
#   EMAIL_FROM                      ← set as Edge Function secret
#   ADMIN_EMAIL                     ← set as Edge Function secret
#   FUNCTION_SECRET                 ← set as Edge Function secret
#
# GitHub Actions (Settings → Secrets → Actions):
#   SUPABASE_FUNCTION_SECRET        ← value of FUNCTION_SECRET above
#   EDGE_FUNCTION_URL_CHECK_MISSED  ← https://your-project-ref.supabase.co/functions/v1/check-missed-tasks
#   EDGE_FUNCTION_URL_PURGE_LOGS    ← https://your-project-ref.supabase.co/functions/v1/purge-old-logs
